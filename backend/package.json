{
  "name": "civicpulse-backend",
  "version": "1.0.0",
  "description": "CivicPulse AI-Powered Civic Complaint Management Platform Backend",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "set-admin": "node ../scripts/set-admin-supabase.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"],
    "collectCoverageFrom": [
      "src/services/*.js",
      "src/middleware/validateComplaint.js",
      "src/config/constants.js"
    ]
  }
}
