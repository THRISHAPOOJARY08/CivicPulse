# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# Supabase Configuration (Free Tier — https://supabase.com/)
# Obtain from Supabase Project Settings -> API
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key...
# Server-only: Never expose this key in frontend code or commit to GitHub!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key...

# ==============================================================================
# Gemini Developer API Configuration (Free Tier — https://aistudio.google.com/)
# ==============================================================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Optional: Safe AI Failure Simulation (Test/Dev only — never enable in production)
ENABLE_AI_FAILURE_TEST=false
AI_FAILURE_TEST_TOKEN=your-local-test-token
